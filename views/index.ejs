<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <h1>Student Management System</h1>
    <nav>
      <a href="/">Student List</a>
      <a href="/students/add">Add Student</a>
    </nav>
  </header>

  <main class="container">
    <% if (message) { %>
      <p class="notice"><%= message %></p>
    <% } %>

    <h2>Student List</h2>

    <!-- Activity 22: search form -->
    <form action="/students/search" method="GET" class="search">
      <input
        type="text"
        name="keyword"
        placeholder="Search student..."
        value="<%= keyword %>"
      >
      <button type="submit">Search</button>
      <% if (keyword) { %>
        <a href="/" class="clear">Clear</a>
      <% } %>
    </form>

    <a class="button" href="/students/add">Add Student</a>

    <div class="table-wrap">
      <table>
        <tr>
          <th>ID</th>
          <th>Student ID</th>
          <th>Name</th>
          <th>Course</th>
          <th>Year</th>
          <th>Email</th>
          <th>Actions</th>
        </tr>

        <% if (students.length === 0) { %>
          <tr>
            <td colspan="7" class="empty">No matching record found.</td>
          </tr>
        <% } %>

        <% students.forEach(student => { %>
          <tr>
            <td><%= student.id %></td>
            <td><%= student.student_id %></td>
            <td>
              <%= student.first_name %>
              <%= student.last_name %>
            </td>
            <td><%= student.course %></td>
            <td><%= student.year_level %></td>
            <td><%= student.email %></td>
            <td>
              <!-- Activity 30: delete uses POST and the student's id -->
              <form
                action="/students/delete/<%= student.id %>"
                method="POST"
                onsubmit="return confirm('Delete this student?');"
              >
                <button type="submit" class="danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </table>
    </div>
  </main>
</body>
</html>
