<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Student</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <h1>Student Management System</h1>
    <nav>
      <a href="/">Student List</a>
      <a href="/students/add">Add Student</a>
    </nav>
  </header>

  <main class="container">
    <h2>Add Student</h2>

    <% if (errors.length > 0) { %>
      <ul class="errors">
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    <% } %>

    <form action="/students/add" method="POST" class="form">
      <label>Student ID:</label>
      <input type="text" name="student_id" value="<%= values.student_id || '' %>">

      <label>First Name:</label>
      <input type="text" name="first_name" value="<%= values.first_name || '' %>">

      <label>Last Name:</label>
      <input type="text" name="last_name" value="<%= values.last_name || '' %>">

      <label>Course:</label>
      <input type="text" name="course" value="<%= values.course || '' %>">

      <label>Year Level:</label>
      <input type="number" name="year_level" min="1" max="5" value="<%= values.year_level || '' %>">

      <label>Email:</label>
      <input type="text" name="email" value="<%= values.email || '' %>">

      <button type="submit">Save Student</button>
    </form>

    <p><a href="/">Back to Student List</a></p>
  </main>
</body>
</html>
